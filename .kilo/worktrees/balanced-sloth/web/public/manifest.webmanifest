{
    "name": "ISU Supply Management System",
    "short_name": "ISU Supply",
    "description": "Isabela State University — Cauayan Campus Supply Management admin portal.",
    "id": "/admin",
    "start_url": "/admin/dashboard",
    "scope": "/",
    "display": "standalone",
    "orientation": "any",
    "background_color": "#ffffff",
