        { "src": "/images/pwa-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
        { "src": "/images/pwa-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
    ]
}
